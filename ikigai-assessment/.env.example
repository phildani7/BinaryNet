# Ikigai Assessment System - Environment Variables

# Database Configuration
DATABASE_URL=postgresql://ikigai_user:your_password@localhost:5432/ikigai_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# LiveKit Configuration
LIVEKIT_URL=wss://your-livekit-server.com
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ElevenLabs Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=g6xIsTj2HwM6VR4iXFCw
ELEVENLABS_STABILITY=0.50
ELEVENLABS_SIMILARITY=0.75

# OpenAI Configuration (for Whisper transcription)
OPENAI_API_KEY=your_openai_api_key

# O*NET API
ONET_API_URL=https://services.onetcenter.org/ws/
ONET_USERNAME=your_onet_username
ONET_PASSWORD=your_onet_password

# BLS API
BLS_API_KEY=your_bls_api_key
BLS_API_URL=https://api.bls.gov/publicAPI/v2/

# Application Settings
APP_NAME=Ikigai Assessment System
APP_VERSION=1.0.0
APP_ENV=development
SECRET_KEY=your_secret_key_here_change_in_production

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ENABLED=true

# File Storage
AUDIO_STORAGE_PATH=/data/audio
TRANSCRIPT_STORAGE_PATH=/data/transcripts
MAX_UPLOAD_SIZE_MB=100

# Model Paths
NLP_MODEL_PATH=./models/nlp
IRT_MODEL_PATH=./models/irt

# Assessment Configuration
MAX_ASSESSMENT_DURATION_MINUTES=45
MIN_RESPONSE_LENGTH_WORDS=10
QUALITY_CHECK_ENABLED=true

# Monitoring
SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Feature Flags
ENABLE_IRT_CHANNEL=true
ENABLE_NLP_CHANNEL=true
ENABLE_QUAL_CHANNEL=true
ENABLE_CTT_CHANNEL=true
